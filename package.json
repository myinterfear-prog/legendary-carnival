{
  "name": "cyberstream-relay",
  "version": "1.0.0",
  "private": true,
  "description": "CyberStream Relay - transparent forward proxy for Gemini/Zen traffic. One portable core, adapters for Cloudflare Workers, Vercel Edge, and Netlify (Edge + Functions).",
  "scripts": {
    "dev": "vercel dev",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dev:netlify": "netlify dev",
    "deploy:netlify": "netlify deploy --prod",
    "deploy:vercel": "vercel --prod",
    "dev:cf": "wrangler dev",
    "deploy:cf": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261028.1",
    "@netlify/edge-functions": "^2.19.0",
    "@netlify/functions": "^4.3.0",
    "@vercel/edge": "^1.3.1",
    "netlify-cli": "^23.15.1",
    "typescript": "^5.7.0",
    "vitest": "^3.2.7",
    "wrangler": "^4.154.0"
  }
}
